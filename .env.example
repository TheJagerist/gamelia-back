# Copier en .env et remplir. Ne jamais committer .env (voir .gitignore).

# --- Serveur ---------------------------------------------------------------------------
PORT=4000
# development | production  (production => cookies "Secure", donc HTTPS obligatoire)
NODE_ENV=development

# Origine EXACTE du front, schéma compris, sans slash final (jamais '*', incompatible avec les cookies).
#   local      : http://localhost:3000
#   production : https://gamelia.exemple.com
FRONT_ORIGIN=http://localhost:3000

# --- PostgreSQL ------------------------------------------------------------------------
DATABASE_URL=postgres://gamelia_app:mot_de_passe@localhost:5432/gamelia

# --- Secrets (générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
SESSION_SECRET=change-me
COOKIE_SECRET=change-me

# --- Cookies ---------------------------------------------------------------------------
# Local : laisser "localhost" (aucun attribut Domain n'est alors envoyé).
# Production : domaine PARENT commun au front et à l'API, avec le point initial.
#   front https://gamelia.exemple.com + API https://api.gamelia.exemple.com  =>  COOKIE_DOMAIN=.gamelia.exemple.com
# Le front lit le cookie CSRF avec document.cookie : sans domaine parent commun, tous les POST échouent en 403.
COOKIE_DOMAIN=localhost
SESSION_COOKIE_NAME=gamelia_session
CSRF_COOKIE_NAME=gamelia_csrf
SESSION_TTL_DAYS=30

# --- Uniquement pour `npm run create-admin` (ne pas laisser dans .env en production) ---
# ADMIN_EMAIL=equipe@exemple.com
# ADMIN_PASSWORD=au-moins-12-caracteres
# ADMIN_NAME=Équipe Gamelia
