{
  "name": "gamelia-back",
  "version": "1.0.0",
  "private": true,
  "description": "Gamelia - API back-end (Concours CADEV by Systalink)",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "seed:demo": "node src/db/seed-demo.js",
    "create-admin": "node src/db/create-admin.js",
    "reset-password": "node src/db/reset-password.js",
    "test": "node --test --test-reporter=spec --test-concurrency=1 tests/*.test.js",
    "licences": "license-checker --production --summary --failOn 'GPL;AGPL;LGPL;GPL-2.0;GPL-3.0;AGPL-3.0;LGPL-2.1;LGPL-3.0'"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.13.1",
    "uuid": "^11.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "license-checker": "^25.0.1"
  },
  "engines": {
    "node": ">=20"
